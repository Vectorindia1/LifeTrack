<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission by design: PRD section 8 requires the app to be
      fully offline for v1. Do not add network permissions.
    -->

    <!-- Required from API 33 to post the daily digest (PRD 7.8). Requested at
         runtime the first time the app opens. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LifeTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LifeTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Today" home-screen widget (session 12). exported=true is required for
             widget receivers — the launcher process binds to it, not this app. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Handles the +250ml/+500ml action buttons on the water reminder
             notification (session 12). Not exported: only this app's own
             PendingIntents ever target it. -->
        <receiver
            android:name=".notification.WaterReminderActionReceiver"
            android:exported="false" />
    </application>

</manifest>
